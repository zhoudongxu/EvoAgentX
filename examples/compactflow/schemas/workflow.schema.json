{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompactFlow bounded typed workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "sinks",
    "applied_policies",
    "unapplied_policies"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "instruction",
          "inputs",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "tool": {
            "enum": [
              "llm",
              "retrieve_context",
              "gaia_agent",
              "gaia_read_file",
              "gaia_unpack_zip",
              "gaia_search",
              "gaia_browse",
              "gaia_download",
              "gaia_vision",
              "gaia_transcribe",
              "gaia_video_frames",
              "gaia_python"
            ]
          },
          "instruction": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^(\\$input|[a-zA-Z][a-zA-Z0-9_]*)\\.[a-zA-Z][a-zA-Z0-9_]*$"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
            }
          }
        }
      }
    },
    "sinks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string"
      }
    },
    "applied_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "unapplied_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
